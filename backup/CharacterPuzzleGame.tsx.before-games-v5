export const CharacterPuzzleGame: React.FC<CharacterPuzzleGameProps> = ({
  settings,
  onBack,
  onWin,
  onGentleRetry,
}) => {
  const [templateIdx, setTemplateIdx] = useState(0);
  const [pieceCount, setPieceCount] = useState<4 | 6 | 9>(4);
  const [showGhostHint, setShowGhostHint] = useState(false);
  const [placedSlots, setPlacedSlots] = useState<Record<number, number>>({});
  const [selectedPieceIdx, setSelectedPieceIdx] = useState<number | null>(null);
  const [showPickerModal, setShowPickerModal] = useState(false);

  const currentTemplate = PUZZLE_CHARACTERS[templateIdx % PUZZLE_CHARACTERS.length];

  // Grid configuration:
  // 4 pieces = 2x2
  // 6 pieces = 3 cols x 2 rows
  // 9 pieces = 3 cols x 3 rows
  const { cols, rows } = useMemo(() => {
    if (pieceCount === 4) return { cols: 2, rows: 2 };
    if (pieceCount === 6) return { cols: 3, rows: 2 };
    return { cols: 3, rows: 3 };
  }, [pieceCount]);

  const totalPieces = cols * rows;

  // Unplaced pieces for the tray
  const unplacedPieces = useMemo(() => {
    const placedIndices = new Set(Object.values(placedSlots));
    const list: number[] = [];
    for (let i = 0; i < totalPieces; i++) {
      if (!placedIndices.has(i)) {
        list.push(i);
      }
    }
    // Stable pseudo-random shuffle so pieces aren't in trivial order
    return list.sort((a, b) => ((a * 7 + templateIdx * 3) % totalPieces) - ((b * 7 + templateIdx * 3) % totalPieces));
  }, [totalPieces, placedSlots, templateIdx]);

  // Reset puzzle when template or piece count changes
  const handleReset = () => {
    setPlacedSlots({});
    setSelectedPieceIdx(null);
    playSoundEffect('pop', settings.volume);
  };

  useEffect(() => {
    setPlacedSlots({});
    setSelectedPieceIdx(null);
  }, [templateIdx, pieceCount]);

  const handleSlotClick = (slotIdx: number, e: React.MouseEvent) => {
    // If slot is already correctly filled, ignore
    if (placedSlots[slotIdx] !== undefined) return;

    if (selectedPieceIdx === null) {
      // Prompt child to pick a piece first
      speakTeacherVoice(
        [{ lang: 'vi', text: 'Bé hãy chạm chọn 1 mảnh ghép ở hàng dưới trước nhé!' }],
        settings
      );
      return;
    }

    // Check if the piece belongs in this slot
    if (selectedPieceIdx === slotIdx) {
      playSoundEffect('sparkle', settings.volume);
      const nextPlaced = { ...placedSlots, [slotIdx]: selectedPieceIdx };
      setPlacedSlots(nextPlaced);
      setSelectedPieceIdx(null);

      // Check win condition
      if (Object.keys(nextPlaced).length >= totalPieces) {
        fireFireworksCelebration();
        speakTeacherVoice(
          [
            { lang: 'en', text: `Great job! ${currentTemplate.nameEn}!` },
            {
              lang: 'vi',
              text: `Tuyệt vời! Bé đã ghép hoàn thành bức tranh ${currentTemplate.nameVi} rồi!`,
            },
          ],
          settings
        );
        if (onWin) onWin();
      } else {
        speakTeacherVoice(
          [{ lang: 'vi', text: 'Đúng rồi! Mảnh ghép vừa khít luôn!' }],
          settings
        );
      }
    } else {
      playGentleEncourageTone(settings.volume);
      if (onGentleRetry) {
        onGentleRetry(
          'Mảnh ghép này chưa đúng vị trí này bé ơi. Bé quan sát hình mẫu và thử lại nhé!',
          'Try another slot!'
        );
      }
    }
  };

  const isCompleted = Object.keys(placedSlots).length === totalPieces;

  return (
    <div className="w-full h-full flex flex-col items-center justify-between gap-1 select-none overflow-hidden">
      {/* 1. Sub-Toolbar: SINGLE ROW, MAX HEIGHT 48px, ICONS ONLY (No text, no title chips, no instructions) */}
      <div className="w-full max-w-md h-11 shrink-0 rounded-2xl border-2 border-amber-400 bg-[#FFFDF5] px-2 shadow-2xs flex items-center justify-between gap-1">
        {/* Left: Back button (if present), Template Picker Icon, Piece count switcher */}
        <div className="flex items-center gap-1 shrink-0">
          {onBack && (
            <button
              type="button"
              onClick={onBack}
              className="w-9 h-9 rounded-xl bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 flex items-center justify-center cursor-pointer transition active:scale-95"
              title="Quay lại"
              aria-label="Quay lại"
            >
              <ArrowLeft className="w-5 h-5 stroke-[2.5]" />
            </button>
          )}

          {/* Change Template: Icon only (no text) */}
          <button
            type="button"
            onClick={() => setShowPickerModal(true)}
            className="w-9 h-9 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 text-white flex items-center justify-center cursor-pointer shadow-2xs transition active:scale-95 text-base"
            title="Đổi tranh nhân vật"
            aria-label="Đổi tranh nhân vật"
          >
            🖼️
          </button>

          {/* Piece count switcher: 4, 6, 9 (compact buttons, numbers only) */}
          <div className="flex items-center bg-amber-100/90 p-0.5 rounded-xl border border-amber-300">
            {[4, 6, 9].map((count) => (
              <button
                key={count}
                type="button"
                onClick={() => {
                  setPieceCount(count as 4 | 6 | 9);
                  handleReset();
                }}
                className={`w-7 h-7 rounded-lg text-xs font-black transition cursor-pointer flex items-center justify-center ${
                  pieceCount === count
                    ? 'bg-amber-500 text-white shadow-2xs'
                    : 'text-amber-950 hover:bg-amber-200/60'
                }`}
                title={`${count} mảnh`}
                aria-label={`${count} mảnh`}
              >
                {count}
              </button>
            ))}
          </div>
        </div>

        {/* Right: Hint (Eye), Reset, Speaker icons only */}
        <div className="flex items-center gap-1 shrink-0">
          <button
            type="button"
            onClick={() => {
              const next = !showGhostHint;
              setShowGhostHint(next);
              playSoundEffect('pop', settings.volume);
            }}
            className={`w-9 h-9 rounded-xl border flex items-center justify-center text-base cursor-pointer transition ${
              showGhostHint
                ? 'bg-amber-400 border-amber-500 text-amber-950 shadow-2xs scale-105'
                : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50'
            }`}
            title="Hình mẫu gợi ý"
            aria-label="Hình mẫu gợi ý"
          >
            👁️
          </button>

          <button
            type="button"
            onClick={handleReset}
            className="w-9 h-9 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-base flex items-center justify-center cursor-pointer transition active:scale-95"
            title="Ghép lại từ đầu"
            aria-label="Ghép lại"
          >
            🔄
          </button>

          <button
            type="button"
            onClick={() =>
              speakTeacherVoice(
                [
                  { lang: 'vi', text: `Bé ghép tranh ${currentTemplate.nameVi} nhé!` },
                  { lang: 'en', text: currentTemplate.nameEn },
                ],
                settings
              )
            }
            className="w-9 h-9 rounded-xl bg-sky-500 hover:bg-sky-600 text-white flex items-center justify-center cursor-pointer shadow-2xs transition active:scale-95"
            title="Nghe hướng dẫn"
            aria-label="Nghe hướng dẫn"
          >
            <Volume2 className="w-5 h-5" />
          </button>
        </div>
      </div>

      {/* 2. Main Puzzle Board: Fills remaining vertical space, maintains aspect-square, as large as possible */}
      <div className="relative flex-1 min-h-0 w-full max-w-md aspect-square rounded-[24px] border-4 border-amber-400 bg-white shadow-md p-1.5 sm:p-2 flex items-center justify-center overflow-hidden">
        {/* Top-Right Mini Complete Sample Preview (Shown when Eye 👁️ is active) */}
        {showGhostHint && (
          <div className="absolute top-2 right-2 z-20 bg-white/95 backdrop-blur-xs border-2 border-amber-300 rounded-xl p-1 shadow-md flex flex-col items-center select-none animate-in fade-in zoom-in-95 duration-200">
            <div className="w-12 h-12 rounded-lg overflow-hidden border border-slate-200 shadow-2xs">
              <img
                src={currentTemplate.imageUrl}
                alt={currentTemplate.nameVi}
                className="w-full h-full object-cover"
              />
            </div>
          </div>
        )}

        {/* Ghost background guide on the board when hint is active */}
        {showGhostHint && !isCompleted && (
          <div className="absolute inset-2 opacity-25 pointer-events-none rounded-xl overflow-hidden">
            <img
              src={currentTemplate.imageUrl}
              alt={currentTemplate.nameVi}
              className="w-full h-full object-cover rounded-xl"
            />
          </div>
        )}

        {/* Puzzle Grid Slots */}
        <div
          className="w-full h-full grid gap-1 sm:gap-1.5 relative z-10"
          style={{
            gridTemplateColumns: `repeat(${cols}, minmax(0, 1fr))`,
            gridTemplateRows: `repeat(${rows}, minmax(0, 1fr))`,
          }}
        >
          {Array.from({ length: totalPieces }).map((_, slotIdx) => {
            const placedPiece = placedSlots[slotIdx];
            const isFilled = placedPiece !== undefined;

            const row = Math.floor(slotIdx / cols);
            const col = slotIdx % cols;

            const slotWidth = 300 / cols;
            const slotHeight = 300 / rows;
            const viewBoxX = col * slotWidth;
            const viewBoxY = row * slotHeight;

            return (
              <div
                key={`slot-${slotIdx}`}
                onClick={(e) => handleSlotClick(slotIdx, e)}
                className={`rounded-xl relative overflow-hidden transition-all duration-150 flex items-center justify-center cursor-pointer ${
                  isFilled
                    ? 'border-2 border-emerald-400 bg-white shadow-2xs'
                    : selectedPieceIdx !== null
                    ? 'border-2 border-dashed border-amber-400 bg-amber-50/70 hover:bg-amber-100/80 animate-pulse'
                    : 'border-2 border-dashed border-slate-200 bg-slate-50/70 hover:border-amber-300'
                }`}
              >
                {isFilled ? (
                  <svg
                    viewBox={`${viewBoxX} ${viewBoxY} ${slotWidth} ${slotHeight}`}
                    className="w-full h-full object-cover"
                  >
                    <image
                      href={currentTemplate.imageUrl}
                      x="0"
                      y="0"
                      width="300"
                      height="300"
                      preserveAspectRatio="xMidYMid slice"
                    />
                  </svg>
                ) : (
                  <span className="text-xs sm:text-sm font-black text-slate-300">
                    {slotIdx + 1}
                  </span>
                )}
              </div>
            );
          })}
        </div>

        {/* Celebration Overlay when finished */}
        {isCompleted && (
          <div className="absolute inset-0 bg-white/95 backdrop-blur-xs z-30 flex flex-col items-center justify-center p-3 text-center animate-in fade-in zoom-in-95 duration-200">
            <span className="text-4xl sm:text-5xl mb-1 animate-bounce">🎉</span>
            <h3 className="text-sm sm:text-base font-black text-amber-900 mb-0.5">
              Hoàn thành xuất sắc!
            </h3>
            <div className="flex items-center gap-2 mt-2">
              <button
                type="button"
                onClick={handleReset}
                className="w-10 h-10 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-950 font-black text-lg flex items-center justify-center cursor-pointer shadow-2xs"
                title="Ghép lại"
              >
                🔄
              </button>
              <button
                type="button"
                onClick={() => {
                  setTemplateIdx((prev) => (prev + 1) % PUZZLE_CHARACTERS.length);
                  handleReset();
                }}
                className="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 text-white font-black text-xs sm:text-sm flex items-center gap-1.5 cursor-pointer shadow-xs"
              >
                <span>Tranh tiếp theo</span>
                <span>➡️</span>
              </button>
            </div>
          </div>
        )}
      </div>

      {/* 3. Pieces Tray Bank: SINGLE HORIZONTAL ROW, BUTTONS 36-40px, NO TEXT INSTRUCTION */}
      <div className="w-full max-w-md h-12 sm:h-14 shrink-0 rounded-2xl border-2 border-amber-300/80 bg-amber-50/70 px-2 flex items-center justify-between gap-1.5 shadow-2xs overflow-hidden">
        <div className="flex-1 min-w-0 flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1">
          {unplacedPieces.length === 0 ? (
            <div className="w-full text-center text-xs font-black text-emerald-700 flex items-center justify-center gap-1">
              <span>⭐</span>
              <span>Đã ghép xong toàn bộ mảnh!</span>
            </div>
          ) : (
            unplacedPieces.map((pieceIdx) => {
              const row = Math.floor(pieceIdx / cols);
              const col = pieceIdx % cols;
              const slotWidth = 300 / cols;
              const slotHeight = 300 / rows;
              const viewBoxX = col * slotWidth;
              const viewBoxY = row * slotHeight;

              const isSelected = selectedPieceIdx === pieceIdx;

              return (
                <button
                  key={`tray-piece-${pieceIdx}`}
                  type="button"
                  onClick={() => {
                    setSelectedPieceIdx(isSelected ? null : pieceIdx);
                    playSoundEffect('pop', settings.volume);
                  }}
                  className={`w-9 h-9 sm:w-10 sm:h-10 rounded-xl overflow-hidden border-2 cursor-pointer transition-all shrink-0 ${
                    isSelected
                      ? 'border-amber-500 ring-4 ring-amber-300 scale-110 shadow-md bg-white -translate-y-0.5'
                      : 'border-slate-300 hover:border-amber-400 bg-white shadow-2xs hover:scale-105'
                  }`}
                  aria-label={`Mảnh ghép ${pieceIdx + 1}`}
                >
                  <svg
                    viewBox={`${viewBoxX} ${viewBoxY} ${slotWidth} ${slotHeight}`}
                    className="w-full h-full object-cover"
                  >
                    <image
                      href={currentTemplate.imageUrl}
                      x="0"
                      y="0"
                      width="300"
                      height="300"
                      preserveAspectRatio="xMidYMid slice"
                    />
                  </svg>
                </button>
              );
            })
          )}
        </div>

        {/* Finished / Done indicator button on right of tray */}
        <button
          type="button"
          onClick={() => {
            if (isCompleted) {
              setTemplateIdx((prev) => (prev + 1) % PUZZLE_CHARACTERS.length);
              handleReset();
            } else {
              speakTeacherVoice(
                [{ lang: 'vi', text: 'Bé ghép nốt các mảnh còn lại nhé!' }],
                settings
              );
            }
          }}
          className={`shrink-0 w-9 h-9 rounded-xl flex items-center justify-center text-base cursor-pointer transition active:scale-95 ${
            isCompleted
              ? 'bg-gradient-to-r from-emerald-500 to-teal-500 text-white shadow-xs'
              : 'bg-white border border-slate-200 text-slate-400 opacity-60'
          }`}
          title="Xong"
          aria-label="Xong"
        >
          {isCompleted ? '⭐' : '✓'}
        </button>
      </div>

      {/* 4. Modal: Chọn Hình Mẫu Nhân Vật */}
      {showPickerModal && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-3 animate-in fade-in duration-150">
          <div className="w-full max-w-lg bg-white rounded-3xl border-2 border-amber-300 shadow-xl p-4 sm:p-5 flex flex-col max-h-[85vh]">
            <div className="flex items-center justify-between pb-3 border-b border-slate-100">
              <div className="flex items-center gap-2">
                <span className="text-2xl">🧩</span>
                <h3 className="text-base sm:text-lg font-black text-slate-900">
                  Chọn Tranh Nhân Vật Cho Bé
                </h3>
              </div>
              <button
                type="button"
                onClick={() => setShowPickerModal(false)}
                className="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-black flex items-center justify-center cursor-pointer"
              >
                ✕
              </button>
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-3 gap-2.5 overflow-y-auto py-3">
              {PUZZLE_CHARACTERS.map((char, idx) => {
                const isSelected = idx === templateIdx % PUZZLE_CHARACTERS.length;
                return (
                  <button
                    key={char.id}
                    type="button"
                    onClick={() => {
                      setTemplateIdx(idx);
                      setShowPickerModal(false);
                      playSoundEffect('sparkle', settings.volume);
                    }}
                    className={`rounded-2xl p-2.5 border-2 flex flex-col items-center text-center gap-1.5 transition cursor-pointer ${
                      isSelected
                        ? 'border-amber-500 bg-amber-50 shadow-xs'
                        : 'border-slate-200 hover:border-amber-300 bg-white'
                    }`}
                  >
                    <div className="w-16 h-16 rounded-xl overflow-hidden border border-slate-200 shadow-2xs">
                      <img
                        src={char.imageUrl}
                        alt={char.nameVi}
                        className="w-full h-full object-cover"
                      />
                    </div>
                    <span className="text-xs font-black text-slate-900 leading-tight">
                      {char.emoji} {char.nameVi}
                    </span>
                    <span className="text-[10px] text-slate-500 font-semibold line-clamp-1">
                      {char.nameEn}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
