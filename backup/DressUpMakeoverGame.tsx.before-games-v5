            <div className="p-3 bg-amber-50/70 border-2 border-pink-200 rounded-2xl shadow-inner w-full flex flex-col items-center">
              <div className="text-5xl my-2">
                {activeCharacterObj.emoji}
              </div>
              <div className="text-sm font-black text-pink-900">
                {activeCharacterObj.nameVi}
              </div>
              <div className="text-xs font-bold text-slate-500 mt-1 flex flex-wrap gap-1 justify-center">
                <span className="bg-white px-2 py-0.5 rounded-full border border-pink-200">
                  {OUTFITS.find((o) => o.id === outfit)?.nameVi}
                </span>
                <span className="bg-white px-2 py-0.5 rounded-full border border-pink-200">
                  {MAKEUPS.find((m) => m.id === makeup)?.nameVi}
                </span>
              </div>
            </div>

            <p className="text-xs font-bold text-slate-600">
              Bé đã tự tay phối đồ và trang điểm rất khéo léo!
            </p>

            <button
              type="button"
              onClick={() => {
                setShowPhotoModal(false);
                if (onWin) onWin();
              }}
              className="w-full py-2.5 rounded-xl bg-gradient-to-r from-pink-500 to-rose-500 text-white font-black text-sm shadow-xs flex items-center justify-center gap-1 cursor-pointer"
            >
              <span>🎉</span>
              <span>Lưu Kỷ Niệm & Chơi Tiếp</span>
            </button>
          </div>
        </div>
      )}
    </div>
  );
};
